{
  "name": "cruise-viewer",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "extract:tui": "node scripts/extract-tui-visible-trips.mjs",
    "fetch:tui": "node scripts/fetch-tui-trips.mjs && node scripts/generate-tui-area-windows.mjs",
    "generate:tui-windows": "node scripts/generate-tui-area-windows.mjs"
  },
  "keywords": [
    "cruise",
    "map",
    "tui-cruises",
    "mein-schiff"
  ],
  "author": "",
  "license": "MIT",
  "description": "Interactive cruise ship area viewer prototype for Mein Schiff / TUI Cruises.",
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "topojson-client": "^3.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "vitest": "^4.1.8"
  }
}
