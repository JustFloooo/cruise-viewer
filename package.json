{
  "name": "cruise-viewer",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "extract:tui": "node scripts/extract-tui-visible-trips.mjs",
    "fetch:tui": "node scripts/fetch-tui-trips.mjs && node scripts/generate-tui-area-windows.mjs",
    "generate:tui-windows": "node scripts/generate-tui-area-windows.mjs"
  },
  "keywords": [
    "cruise",
    "map",
    "tui-cruises",
    "mein-schiff"
  ],
  "author": "",
  "license": "MIT",
  "description": "Interactive cruise ship area viewer prototype for Mein Schiff / TUI Cruises.",
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3"
  }
}
